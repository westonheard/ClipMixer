<Window x:Class="ClipMixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipMixer"
        Title="ClipMixer" Height="860" Width="1400" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextFg}"
        PreviewKeyDown="windowPreviewKeyDown"
        PreviewMouseDown="windowPreviewMouseDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- in/out marker handle -->
        <Style x:Key="MarkerThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Polygon Points="0,0 16,0 8,10" Fill="{TemplateBinding Foreground}"/>
                            <Rectangle Width="2" Height="28" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- playhead -->
        <Style x:Key="PlayheadThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Rectangle Width="2" Height="44" Fill="White" HorizontalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Focusable="True" FocusVisualStyle="{x:Null}" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" MinWidth="240"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- left side, clip list + queue -->
        <Border Grid.Column="0" Style="{StaticResource Panel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Click="openFolderClick" Padding="12,5"
                                ToolTip="Open a clip folder (Ctrl+O)">Open folder...</Button>
                        <Button DockPanel.Dock="Left" Margin="6,0,0,0" Click="refreshClick" Padding="10,5"
                                ToolTip="Rescan folder">Refresh</Button>
                    </DockPanel>
                    <TextBlock x:Name="FolderText" Margin="0,8,0,0" Foreground="{StaticResource DimFg}" TextTrimming="CharacterEllipsis"
                               Text="No folder open"/>
                    <CheckBox x:Name="SubfoldersCheck" Margin="0,6,0,0" Content="Include subfolders"
                              Checked="subfoldersChanged" Unchecked="subfoldersChanged"/>
                    <TextBlock x:Name="ScanText" Margin="0,6,0,6" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>

                <ListBox x:Name="ClipList" Grid.Row="1" SelectionMode="Single"
                         SelectionChanged="clipListSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ClipEntry}">
                            <StackPanel x:Name="Item" Margin="2,3">
                                <DockPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Foreground="{StaticResource DimFg}" FontSize="11" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding DurationText, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding SizeText, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding DateText, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding Folder, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Note}" Foreground="{StaticResource WarnFg}" FontSize="11" TextWrapping="Wrap"
                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Click="clearFinishedClick" Padding="8,2" FontSize="11">Clear finished</Button>
                        <TextBlock Text="Processing" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                        <ItemsControl x:Name="JobList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ClipJob}">
                                    <Border Margin="0,0,0,6" Padding="6" CornerRadius="4" Background="{StaticResource InsetBg}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="St" Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource DimFg}"/>
                                            <ProgressBar Height="4" Margin="0,4,0,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Failed}" Value="True">
                                            <Setter TargetName="St" Property="Foreground" Value="{StaticResource ErrorFg}"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsFinished}" Value="True"/>
                                                <Condition Binding="{Binding Failed}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="St" Property="Foreground" Value="{StaticResource OkFg}"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False"/>

        <!-- right side, player + editing -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="160"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock x:Name="FileText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="No clip selected"/>
                <TextBlock x:Name="ClipInfoText" Foreground="{StaticResource DimFg}" Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="Black" CornerRadius="6" MouseLeftButtonDown="videoMouseLeftButtonDown">
                <local:MpvHost x:Name="Mpv"/>
            </Border>

            <!-- timeline -->
            <Canvas x:Name="Timeline" Grid.Row="2" Height="52" Margin="0,8,0,0" Background="Transparent" ClipToBounds="False"
                    SizeChanged="timelineSizeChanged" MouseLeftButtonDown="timelineMouseLeftButtonDown">
                <Rectangle x:Name="TimelineTrack" Height="6" RadiusX="3" RadiusY="3" Fill="#55555F"/>
                <Rectangle x:Name="TimelineSelection" Height="6" RadiusX="3" RadiusY="3" Fill="#4A9EFF" Opacity="0.85"/>
                <Rectangle x:Name="KeyframeMarker" Width="2" Height="18" Fill="#FFB347" Visibility="Collapsed"
                           ToolTip="Where a lossless cut really starts (nearest keyframe at/before In)"/>
                <Thumb x:Name="InThumb" Style="{StaticResource MarkerThumbStyle}" Foreground="#7CD992" ToolTip="In (I)"
                       DragStarted="markerDragStarted" DragCompleted="markerDragCompleted" DragDelta="inThumbDragDelta"/>
                <Thumb x:Name="OutThumb" Style="{StaticResource MarkerThumbStyle}" Foreground="#FF7C7C" ToolTip="Out (O)"
                       DragStarted="markerDragStarted" DragCompleted="markerDragCompleted" DragDelta="outThumbDragDelta"/>
                <Thumb x:Name="PlayheadThumb" Style="{StaticResource PlayheadThumbStyle}"
                       DragStarted="markerDragStarted" DragCompleted="markerDragCompleted" DragDelta="playheadThumbDragDelta"/>
            </Canvas>

            <!-- play buttons + in/out -->
            <WrapPanel Grid.Row="4" Margin="0,6,0,0" VerticalAlignment="Center">
                <Button Click="prevClick" ToolTip="Previous clip (Up / P)" Padding="10,5">&lt; Prev</Button>
                <Button x:Name="PlayPauseButton" Margin="6,0,0,0" Width="80" Click="playPauseClick" ToolTip="Space">Play</Button>
                <Button Margin="6,0,0,0" Click="nextClick" ToolTip="Next clip / skip (Down / N)" Padding="10,5">Next &gt;</Button>

                <TextBlock x:Name="TimeText" Margin="14,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" Width="200"/>

                <TextBlock Text="In" Margin="8,0,6,0" VerticalAlignment="Center" Foreground="#7CD992" FontWeight="Bold"/>
                <TextBox x:Name="InText" Width="96" VerticalContentAlignment="Center" FontFamily="Consolas" LostFocus="inOutTextLostFocus"/>
                <Button Margin="4,0,0,0" Click="setInClick" ToolTip="Set In at playhead (I)" Padding="8,5">Set (I)</Button>

                <TextBlock Text="Out" Margin="14,0,6,0" VerticalAlignment="Center" Foreground="#FF7C7C" FontWeight="Bold"/>
                <TextBox x:Name="OutText" Width="96" VerticalContentAlignment="Center" FontFamily="Consolas" LostFocus="inOutTextLostFocus"/>
                <Button Margin="4,0,0,0" Click="setOutClick" ToolTip="Set Out at playhead (O)" Padding="8,5">Set (O)</Button>

                <TextBlock x:Name="KeepText" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </WrapPanel>

            <!-- trim/delete + options -->
            <Border Grid.Row="5" Margin="0,10,0,0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="TrimButton" Style="{StaticResource AccentButton}" Click="trimClick"
                                ToolTip="Cut to In/Out, check it plays fully, then replace the original (Enter)">Trim &amp; Replace  (Enter)</Button>
                        <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="deleteClick"
                                ToolTip="Delete this clip (Del)">Delete clip  (Del)</Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock x:Name="CutInfoText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="AudioPlanText" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox x:Name="PreciseCheck" Margin="0,0,16,4" Checked="optionChanged" Unchecked="optionChanged"
                                      Content="Frame-accurate start (re-encodes, slower)"
                                      ToolTip="Off: lossless, starts on the nearest keyframe at/before In (fast).&#x0a;On: re-encodes video to H.264 so it starts exactly at In."/>
                            <CheckBox x:Name="RecycleCheck" Margin="0,0,16,4" Content="Use Recycle Bin" Checked="optionChanged" Unchecked="optionChanged"
                                      ToolTip="Send deleted clips and replaced originals to the Recycle Bin"/>
                            <CheckBox x:Name="ConfirmDeleteCheck" Margin="0,0,16,4" Content="Confirm deletes" Checked="optionChanged" Unchecked="optionChanged"/>
                            <CheckBox x:Name="AutoPlayCheck" Margin="0,0,16,4" Content="Auto-play clips" Checked="optionChanged" Unchecked="optionChanged"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- audio, per track volume -->
            <Expander x:Name="AudioExpander" Grid.Row="6" Margin="0,8,0,0" Expanded="audioExpanderChanged" Collapsed="audioExpanderChanged">
                <Expander.Header>
                    <TextBlock x:Name="AudioHeaderText" Text="Audio tracks" FontWeight="SemiBold"/>
                </Expander.Header>
                <Border Style="{StaticResource Panel}" Margin="0,6,0,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button Click="resetAudioClick" Margin="0,0,6,4" Padding="8,3" ToolTip="Reset every track to untouched">Reset audio</Button>
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" FontSize="11" Foreground="{StaticResource DimFg}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="The player plays all kept tracks together."/>
                        <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TrackList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:TrackSettings}">
                                        <Border Background="{StaticResource InsetBg}" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                            <StackPanel>
                                                <WrapPanel>
                                                    <CheckBox IsChecked="{Binding Keep}" Margin="0,0,10,2" MinWidth="150"
                                                              ToolTip="Untick to leave this track out of the file (or the mix)">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                    </CheckBox>
                                                    <TextBlock Text="{Binding Info}" Foreground="{StaticResource DimFg}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,2"/>
                                                    <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,6,2"/>
                                                    <Slider Width="170" Minimum="0" Maximum="3" SmallChange="0.05" LargeChange="0.25" VerticalAlignment="Center"
                                                            Value="{Binding Volume, Mode=TwoWay}" Focusable="False" IsMoveToPointEnabled="True" Margin="0,0,6,2"
                                                            ToolTip="0% to 300%. Click the value to reset to 100%."/>
                                                    <TextBlock Text="{Binding VolumeText}" Width="108" VerticalAlignment="Center" Margin="0,0,10,2"
                                                               MouseLeftButtonDown="volumeTextMouseDown" Cursor="Hand" ToolTip="Click to reset to 100%"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Expander>

            <!-- status + key list -->
            <StackPanel Grid.Row="7" Margin="0,8,0,0">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource DimFg}" TextWrapping="Wrap"
                           Text="Keys:  Space play/pause  |  I / O set In / Out  |  Left/Right seek 5s (Shift 1s)  |  Home jump to In  |  Up/Down or P/N prev/next clip  |  Enter trim &amp; replace  |  Del delete  |  Ctrl+O open folder"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
